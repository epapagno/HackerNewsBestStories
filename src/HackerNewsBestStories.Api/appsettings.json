{
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/",
    "CacheSeconds": 60,
    "MaxConcurrency": 20,
    "MaxRequestedStories": 500,
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
