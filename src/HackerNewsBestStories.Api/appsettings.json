{
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/",
    "CacheSeconds": 21600,
    "MaxStaleSeconds": 300,
    "RefreshRetrySeconds": 15,
    "MaxConcurrency": 20,
    "MaxRequestedStories": 500,
    "TimeoutSeconds": 10,
    "RefreshRetryWithDataSeconds": 10800,
    "RefreshLeaseSeconds": 600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  }
}
